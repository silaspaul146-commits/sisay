# Copy to .env.local for local development. These are public values (they end up in the browser
# bundle); no secrets belong here. On Render, set them as environment variables of the static site.
NEXT_PUBLIC_API_BASE=https://sisay.onrender.com/api/v1
NEXT_PUBLIC_AUTH0_DOMAIN=dev-xxxx.us.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=your-single-page-application-client-id
NEXT_PUBLIC_AUTH0_AUDIENCE=https://sisay.onrender.com/api
