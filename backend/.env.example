APP_ENV=development
# Runtime connection (dev: owner role; staging/production: app_citizen / app_worker style roles)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/crisis
# Public map routes: role with SELECT on the two public views only
PUBLIC_DATABASE_URL=postgresql+psycopg://app_public:app_public@localhost:5432/crisis
# Alembic runs as the migrator/owner
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/crisis
# JSON map of pepper versions to secrets. Use a secret store outside development.
TOKEN_PEPPERS={"1": "dev-only-pepper-change-me"}
TOKEN_PEPPER_ACTIVE_VERSION=1
